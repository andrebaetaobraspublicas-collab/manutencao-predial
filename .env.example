# Variáveis usadas pelo Docker Compose de produção
MYSQL_DATABASE="gestaopredios"
MYSQL_USER="gestaopredios"
MYSQL_PASSWORD="troque-por-uma-senha-forte"
MYSQL_ROOT_PASSWORD="troque-por-outra-senha-forte"

# Banco local. Na Hostinger, substitua pelo host, usuário e senha fornecidos no hPanel/VPS.
DATABASE_URL="mysql://gestaopredios:gestaopredios_dev@localhost:3306/gestaopredios"
DB_CONNECTION_LIMIT=10

# API
API_PORT=3001
API_BASE_URL="http://localhost:3001"
WEB_BASE_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
JWT_ACCESS_SECRET="troque-por-um-segredo-com-pelo-menos-32-caracteres"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=""
COOKIE_SECURE=false
UPLOAD_ROOT="./uploads"
MAX_UPLOAD_MB=20

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# Stripe (modo teste durante o MVP)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ESSENCIAL_MONTHLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""

# Geocodificação/mapas: configurar somente quando o módulo de mapas for ativado.
MAP_PROVIDER="maplibre"
GEOCODING_PROVIDER=""
GEOCODING_API_KEY=""
