# Variáveis usadas pelo Docker Compose de produção
MYSQL_DATABASE="gestaopredios"
MYSQL_USER="gestaopredios"
MYSQL_PASSWORD="troque-por-uma-senha-forte"
MYSQL_ROOT_PASSWORD="troque-por-outra-senha-forte"

# Banco local. Na Hostinger, substitua pelo host, usuário e senha fornecidos no hPanel/VPS.
DATABASE_URL="mysql://gestaopredios:gestaopredios_dev@localhost:3306/gestaopredios"
DB_CONNECTION_LIMIT=10

# API
API_PORT=3001
# Em testes locais, restrinja a interface ao loopback. Na Hostinger deixe 0.0.0.0.
API_BIND_HOST="127.0.0.1"
API_BASE_URL="http://localhost:3001"
WEB_BASE_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
JWT_ACCESS_SECRET="troque-por-um-segredo-com-pelo-menos-32-caracteres"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=""
COOKIE_SECURE=false
UPLOAD_ROOT="./uploads"
MAX_UPLOAD_MB=20
MAX_JSON_MB=20
# OrçaPro usa a sessão existente e catálogos globais separados dos dados de manutenção.
# Habilite somente após migration, importação validada e homologação.
ORCAPRO_ENABLED=false
# true somente na API comercial exclusiva OrçaPro: bloqueia cadastro público da manutenção.
# O desenvolvimento com os dois programas usa false. Contas/admin/vendas diretas não são alterados.
ORCAPRO_ONLY=false
# IDs internos de usuários autorizados à administração global SINAPI; OWNER de tenant não concede este papel.
ORCAPRO_ADMIN_USER_IDS=""
# OrçaPro Infraestrutura: banco MySQL exclusivo. Não reutilizar DATABASE_URL.
# Habilitar somente no desenvolvimento www.gestaodepredios.com.br, após migrations/seed/testes.
INFRA_ENABLED=false
INFRA_DATABASE_URL="mysql://infraestrutura:senha-exclusiva@localhost:3306/orcapro_infraestrutura"
# IDs da identidade central autorizados à administração global do SICRO.
INFRA_ADMIN_USER_IDS=""
# Opcional: segredo próprio da limitação de login; se vazio usa JWT_ACCESS_SECRET no servidor.
INFRA_RATE_LIMIT_SECRET=""
# Token de mutação vinculado ao cookie de sessão; vazio usa JWT_ACCESS_SECRET no servidor.
INFRA_CSRF_SECRET=""
# Histórico de projetos (10 a 500 versões); fechamento LGPD com expurgo após 1 a 365 dias.
INFRA_PROJECT_VERSION_RETENTION=100
INFRA_DELETED_DATA_RETENTION_DAYS=30
# Snapshot/base raw importado pelo admin: limite de lote comprimido 2MB; projeto JSON 20MB.
# Backup privado diário: retenção fixa de 14 dias. Não usar public_html/public/wwwroot.
INFRA_BACKUP_DIR="/home/usuario/backups/orcapro-infraestrutura"
INFRA_MYSQLDUMP_BIN="mysqldump"
# Opcional: PUT HTTPS para armazenamento privado (URL pré-assinada, nunca pública/logada).
INFRA_BACKUP_UPLOAD_URL=""
# Opcional: arquivo .env privado carregado pelo CLI/cron sem imprimir seus valores.
INFRA_ENV_FILE=""
SEED_ADMIN_EMAIL="admin@gestaodepredios.com.br"
SEED_ADMIN_PASSWORD="defina-uma-senha-local-com-12-ou-mais-caracteres"
# Defina como false antes da limpeza definitiva dos registros DEMO.
SEED_CONTRACT_TEST_DATA_ENABLED=true

# E-mail transacional (Resend). Em desenvolvimento, links são registrados no log se vazio.
EMAIL_FROM="Gestão de Prédios <nao-responda@gestaodepredios.com.br>"
RESEND_API_KEY=""
EMAIL_TIMEOUT_MS=10000

# Caixa interna, outbox e alertas operacionais
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_POLL_INTERVAL_MS=5000
NOTIFICATION_BATCH_SIZE=10
NOTIFICATION_MAX_ATTEMPTS=6
NOTIFICATION_RETRY_BASE_MS=30000
NOTIFICATION_PROCESSING_STALE_MS=300000
NOTIFICATION_ALERT_SCAN_INTERVAL_MS=60000
NOTIFICATION_SLA_WARNING_MINUTES=120
NOTIFICATION_SLA_MAX_WARNING_MINUTES=10080
NOTIFICATION_SLA_LOOKBACK_DAYS=30
NOTIFICATION_CONTRACT_EXPIRING_DAYS=30

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_ORCAPRO_ONLY=false
NEXT_PUBLIC_MARKETING_URL="https://orcaproobras.com.br/"

# Stripe (modo teste durante o MVP)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ESSENCIAL_MONTHLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_ENTERPRISE_MONTHLY=""

# OrçaPro individual: conta e endpoints próprios, independentes da manutenção.
# TEST no desenvolvimento; LIVE na produção. Nunca misture preços/chaves dos dois modos.
ORCAPRO_STRIPE_SECRET_KEY=""
ORCAPRO_STRIPE_WEBHOOK_SECRET=""
ORCAPRO_STRIPE_MODE="TEST"
# Opcional: configuração própria do Portal, sem alterar o padrão de outros produtos Stripe.
ORCAPRO_STRIPE_PORTAL_CONFIGURATION_ID=""
# Retorno ao cancelar contratação; somente URL HTTPS configurada pelo operador.
ORCAPRO_MARKETING_URL="https://orcaproobras.com.br/"

# Geocodificação/mapas: configurar somente quando o módulo de mapas for ativado.
MAP_PROVIDER="maplibre"
GEOCODING_PROVIDER="nominatim"
# Obrigatória somente quando GEOCODING_PROVIDER="geoapify".
GEOCODING_API_KEY=""
GEOCODING_CACHE_DAYS=30
# Resultados vazios usam TTL curto para permitir nova tentativa rapidamente.
GEOCODING_NEGATIVE_CACHE_MINUTES=15
# Limites separados por organização e por vínculo de usuário.
GEOCODING_TENANT_RATE_LIMIT_HOUR=60
GEOCODING_MEMBERSHIP_RATE_LIMIT_HOUR=20
# O código ainda aceita os aliases legados quando as variáveis acima não existem.
GEOCODING_USER_AGENT="GestaoDePredios/0.7 (+https://www.gestaodepredios.com.br)"

# Importação inicial opt-in do catálogo global; UUID de usuário existente autorizado.
ORCAPRO_SEED_ON_DEPLOY=false
ORCAPRO_SEED_ADMIN_USER_ID=""
