# Copie para .env apenas no servidor. Nunca versione o arquivo real.
# Use segredos aleatórios e URL-encode usuário/senha no DATABASE_URL.

NODE_ENV=production

# Banco MySQL do Docker Compose
MYSQL_DATABASE=gestaopredios
MYSQL_USER=gestaopredios
MYSQL_PASSWORD=troque-por-uma-senha-forte
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-forte
DATABASE_URL=mysql://gestaopredios:SENHA_URL_ENCODED@mysql:3306/gestaopredios
DB_CONNECTION_LIMIT=10

# API e aplicação
API_PORT=3001
API_BASE_URL=https://api.gestaodepredios.com.br
WEB_BASE_URL=https://www.gestaodepredios.com.br
CORS_ORIGINS=https://www.gestaodepredios.com.br
JWT_ACCESS_SECRET=gere-um-segredo-aleatorio-com-no-minimo-32-caracteres
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=.gestaodepredios.com.br
COOKIE_SECURE=true
UPLOAD_ROOT=/data/uploads
MAX_UPLOAD_MB=20
SEED_ADMIN_EMAIL=admin@gestaodepredios.com.br
SEED_ADMIN_PASSWORD=gere-uma-senha-exclusiva-com-12-ou-mais-caracteres

# Frontend
NEXT_PUBLIC_API_URL=https://api.gestaodepredios.com.br/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Stripe — iniciar em modo teste
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENCIAL_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=

# Geocodificação
MAP_PROVIDER=maplibre
GEOCODING_PROVIDER=
GEOCODING_API_KEY=
