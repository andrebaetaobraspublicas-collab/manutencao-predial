# Copie para .env apenas no servidor. Nunca versione o arquivo real.
# Use segredos aleatórios e URL-encode usuário/senha no DATABASE_URL.

NODE_ENV=production

# Banco MySQL do Docker Compose
MYSQL_DATABASE=gestaopredios
MYSQL_USER=gestaopredios
MYSQL_PASSWORD=troque-por-uma-senha-forte
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-forte
DATABASE_URL=mysql://gestaopredios:SENHA_URL_ENCODED@mysql:3306/gestaopredios
DB_CONNECTION_LIMIT=10

# API e aplicação
API_PORT=3001
# Web Apps gerenciados injetam PORT automaticamente; a API prioriza esse valor.
API_BASE_URL=https://api.gestaodepredios.com.br
WEB_BASE_URL=https://www.gestaodepredios.com.br
CORS_ORIGINS=https://www.gestaodepredios.com.br
JWT_ACCESS_SECRET=gere-um-segredo-aleatorio-com-no-minimo-32-caracteres
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=.gestaodepredios.com.br
COOKIE_SECURE=true
UPLOAD_ROOT=/data/uploads
MAX_UPLOAD_MB=20
SEED_ADMIN_EMAIL=admin@gestaodepredios.com.br
SEED_ADMIN_PASSWORD=gere-uma-senha-exclusiva-com-12-ou-mais-caracteres

# E-mail transacional para convites, redefinição de senha e verificação.
EMAIL_FROM="Gestão de Prédios <nao-responda@gestaodepredios.com.br>"
RESEND_API_KEY=
EMAIL_TIMEOUT_MS=10000

# Caixa interna, outbox e alertas operacionais
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_POLL_INTERVAL_MS=5000
NOTIFICATION_BATCH_SIZE=10
NOTIFICATION_MAX_ATTEMPTS=6
NOTIFICATION_RETRY_BASE_MS=30000
NOTIFICATION_PROCESSING_STALE_MS=300000
NOTIFICATION_ALERT_SCAN_INTERVAL_MS=60000
NOTIFICATION_SLA_WARNING_MINUTES=120
NOTIFICATION_SLA_MAX_WARNING_MINUTES=10080
NOTIFICATION_SLA_LOOKBACK_DAYS=30
NOTIFICATION_CONTRACT_EXPIRING_DAYS=30

# Frontend
NEXT_PUBLIC_API_URL=https://api.gestaodepredios.com.br/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Stripe — iniciar em modo teste
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENCIAL_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=

# Geocodificação
MAP_PROVIDER=maplibre
GEOCODING_PROVIDER=disabled
# Produção inicia desabilitada; valores aceitos: disabled, nominatim ou geoapify.
# GEOCODING_API_KEY é obrigatória somente para geoapify.
GEOCODING_API_KEY=
GEOCODING_CACHE_DAYS=30
GEOCODING_NEGATIVE_CACHE_MINUTES=15
GEOCODING_TENANT_RATE_LIMIT_HOUR=60
GEOCODING_MEMBERSHIP_RATE_LIMIT_HOUR=20
# O código ainda aceita os aliases legados quando as variáveis acima não existem.
GEOCODING_USER_AGENT="GestaoDePredios/0.7 (+https://www.gestaodepredios.com.br)"
