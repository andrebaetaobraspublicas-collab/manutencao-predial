# Nunca reutilize credenciais, banco, cookies ou uploads de produção.
DATABASE_URL="mysql://staging_user:troque-a-senha@staging-db.example:3306/gestaopredios_staging"
DB_CONNECTION_LIMIT=5
API_PORT=3001
API_BASE_URL="https://api-staging.gestaodepredios.com.br"
WEB_BASE_URL="https://staging.gestaodepredios.com.br"
CORS_ORIGINS="https://staging.gestaodepredios.com.br"
JWT_ACCESS_SECRET="gere-um-segredo-exclusivo-com-ao-menos-32-caracteres"
COOKIE_DOMAIN=".staging.gestaodepredios.com.br"
COOKIE_SECURE=true
UPLOAD_ROOT="./uploads-staging"
NEXT_PUBLIC_API_URL="https://api-staging.gestaodepredios.com.br/api/v1"
HOSTINGER_STATIC_EXPORT=1
SEED_ADMIN_EMAIL="admin-staging@gestaodepredios.com.br"
SEED_ADMIN_PASSWORD="defina-uma-senha-exclusiva-de-staging"
NOTIFICATION_WORKER_ENABLED=false
GEOCODING_PROVIDER="disabled"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RELEASE_SHA="local-staging"

