{
  "name": "@gestaopredios/api",
  "version": "0.18.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "build:api:hostinger": "npm run hostinger:deploy",
    "hostinger:deploy": "npm run prisma:generate && npm run build && npm run hostinger:prepare && npm run prisma:deploy && npm run prisma:seed && npm run hostinger:verify-artifact",
    "hostinger:prepare": "node scripts/hostinger-prepare-output.mjs",
    "hostinger:verify": "node -e \"const fs=require('node:fs');if(!fs.existsSync('dist/main.js')){throw new Error('Missing prebuilt dist/main.js')}console.log('Prebuilt API artifact verified')\"",
    "hostinger:verify-artifact": "node -e \"const fs=require('node:fs');if(!fs.existsSync('dist/main.js')){throw new Error('Missing Hostinger output dist/main.js')}console.log('Hostinger API output verified')\"",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "@nestjs/cli": "11.0.24",
    "@nestjs/common": "11.1.28",
