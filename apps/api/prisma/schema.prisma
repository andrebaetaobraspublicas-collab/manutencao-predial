generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  EXPIRED
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  CONTRACT_MANAGER
  CONTRACT_INSPECTOR
  OPERATOR
  REQUESTER
  AUDITOR
}

enum BuildingStatus {
  ACTIVE
  INACTIVE
  UNDER_CONSTRUCTION
  DISPOSED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  UNDER_REVIEW
}

enum ContractType {
  PREVENTIVE_MAINTENANCE
  CORRECTIVE_MAINTENANCE
  INTEGRATED_MAINTENANCE
  OUTSOURCED_LABOR
  SUPPLY
  OTHER
}

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRING
  EXPIRED
  TERMINATED
  CLOSED
}

enum AmendmentType {
  VALUE_INCREASE
  VALUE_DECREASE
  SCOPE_CHANGE
  TERM_EXTENSION
  OTHER
}

enum AdjustmentType {
  PRICE_ADJUSTMENT
  REPACTUATION
  ECONOMIC_REBALANCING
}

enum PenaltyType {
  WARNING
  FINE
  TEMPORARY_SUSPENSION
  DEBARMENT
  OTHER
}

enum CommitmentMovementType {
  ISSUE
  REINFORCEMENT
  CANCELLATION
  LIQUIDATION
  PAYMENT
}

enum MeasurementStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  LIQUIDATED
  PAID
  CANCELED
}

enum WorkOrderStatus {
  OPEN
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  PENDING
  WAITING_APPROVAL
  COMPLETED
  CLOSED
  CANCELED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum WorkOrderOrigin {
  USER_REQUEST
  PREVENTIVE_PLAN
  INSPECTION
  RECURRENT_FAILURE
  CONTRACT_REQUIREMENT
  OTHER
}

enum PendencyStatus {
  OPEN
  RESOLVED
  CANCELED
}

enum AttachmentKind {
  PHOTO_BEFORE
  PHOTO_DURING
  PHOTO_AFTER
  INVOICE_PDF
  TECHNICAL_REPORT
  QUOTATION
  OTHER_DOCUMENT
}

enum BudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELED
}

enum BudgetItemKind {
  SERVICE
  INPUT
  COMPOSITION
  OTHER
}

enum SinapiItemType {
  INPUT
  COMPOSITION
  SERVICE
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  DISPOSED
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenancePlanType {
  PREVENTIVE
  PREDICTIVE
  INSPECTION
  LEGAL_COMPLIANCE
}

enum FrequencyUnit {
  DAY
  WEEK
  MONTH
  BIMONTH
  QUARTER
  SEMESTER
  YEAR
  METER_READING
}

enum MaintenanceGenerationStatus {
  PENDING
  GENERATED
  SKIPPED
  FAILED
}

enum KpiCategory {
  OPERATIONAL
  SLA
  SATISFACTION
  FINANCIAL
  CONTRACTUAL
  SUSTAINABILITY
  RELIABILITY
  SAFETY
}

enum KpiDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
  TARGET_RANGE
}

enum KpiPeriodicity {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum KpiMeasurementStatus {
  FINAL
  FAILED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  MANUAL_CONTRACT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
  EXPORT
  DOWNLOAD
  BILLING_CHANGE
  INVITE
  SESSION_REVOKE
  PASSWORD_CHANGE
  EMAIL_VERIFY
}

enum AccountTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum OperationalCatalogKind {
  CATEGORY
  SPECIALTY
  ENVIRONMENT
  CAUSE
}

enum SlaTimeMode {
  CALENDAR
  BUSINESS
}

enum NotificationEventType {
  WORK_ORDER_CREATED
  WORK_ORDER_ASSIGNED
  WORK_ORDER_STATUS_CHANGED
  WORK_ORDER_COMMENT_MENTION
  WORK_ORDER_PENDENCY_CREATED
  WORK_ORDER_PENDENCY_RESOLVED
  WORK_ORDER_SLA_WARNING
  WORK_ORDER_SLA_BREACHED
  CONTRACT_EXPIRING
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Tenant {
  id                   String                      @id @default(uuid()) @db.Char(36)
  name                 String                      @db.VarChar(160)
  slug                 String                      @unique @db.VarChar(100)
  taxId                String?                     @db.VarChar(24)
  status               TenantStatus                @default(TRIAL)
  timezone             String                      @default("America/Sao_Paulo") @db.VarChar(60)
  locale               String                      @default("pt-BR") @db.VarChar(10)
  trialEndsAt          DateTime?
  stripeCustomerId     String?                     @unique @db.VarChar(120)
  settings             Json?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  deletedAt            DateTime?
  memberships          TenantMembership[]
  buildings            Building[]
  suppliers            Supplier[]
  contracts            Contract[]
  workOrders           WorkOrder[]
  workOrderPendencies  WorkOrderPendency[]
  workOrderAttachments WorkOrderAttachment[]
  workOrderBudgets     WorkOrderBudget[]
  budgetItems          BudgetItem[]
  budgetRevisions      BudgetRevision[]
  sinapiCatalogs       SinapiCatalog[]
  sinapiCatalogItems   SinapiCatalogItem[]
  measurements         Measurement[]
  measurementItems     MeasurementItem[]
  commitments          Commitment[]
  commitmentMovements  CommitmentMovement[]
  penalties            ContractPenalty[]
  assets               Asset[]
  maintenancePlans     MaintenancePlan[]
  maintenanceRuns      MaintenancePlanGeneration[]
  kpiDefinitions       KpiDefinition[]
  kpiMeasurements      KpiMeasurement[]
  subscriptions        TenantSubscription[]
  auditLogs            AuditLog[]
  sequences            TenantSequence[]
  invitations          TenantInvitation[]
  operationalCatalog   OperationalCatalogItem[]
  checklistTemplates   ChecklistTemplateItem[]
  slaCalendars         SlaCalendar[]
  slaHolidays          SlaHoliday[]
  slaPolicies          SlaPolicy[]
  geocodingCache       GeocodingCache[]
  workOrderComments    WorkOrderComment[]
  workOrderChecklists  WorkOrderChecklistItem[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  notificationOutbox   NotificationOutbox[]
  reopenings           WorkOrderReopening[]

  @@index([status])
  @@index([deletedAt])
}

model User {
  id                       String                       @id @default(uuid()) @db.Char(36)
  name                     String                       @db.VarChar(160)
  email                    String                       @unique @db.VarChar(190)
  passwordHash             String                       @db.VarChar(255)
  phone                    String?                      @db.VarChar(30)
  status                   UserStatus                   @default(ACTIVE)
  emailVerifiedAt          DateTime?
  lastLoginAt              DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  deletedAt                DateTime?
  memberships              TenantMembership[]
  refreshSessions          RefreshSession[]
  requestedWorkOrders      WorkOrder[]                  @relation("WorkOrderRequester")
  assignedWorkOrders       WorkOrder[]                  @relation("WorkOrderAssignee")
  createdWorkOrders        WorkOrder[]                  @relation("WorkOrderCreator")
  managedBuildings         Building[]                   @relation("BuildingManager")
  managedContracts         Contract[]                   @relation("ContractManager")
  inspectedContracts       Contract[]                   @relation("ContractInspector")
  pendenciesResponsibleFor WorkOrderPendency[]          @relation("PendencyResponsible")
  uploadedAttachments      WorkOrderAttachment[]        @relation("AttachmentUploader")
  statusChanges            WorkOrderStatusHistory[]     @relation("StatusChangedBy")
  satisfactionResponses    SatisfactionResponse[]       @relation("SatisfactionResponder")
  approvedMeasurements     Measurement[]                @relation("MeasurementApprover")
  createdMeasurements      Measurement[]                @relation("MeasurementCreator")
  reviewedMeasurements     Measurement[]                @relation("MeasurementReviewer")
  createdCommitments       Commitment[]                 @relation("CommitmentCreator")
  commitmentMovements      CommitmentMovement[]         @relation("CommitmentMovementCreator")
  submittedBudgets         WorkOrderBudget[]            @relation("BudgetSubmitter")
  approvedBudgets          WorkOrderBudget[]            @relation("BudgetApprover")
  budgetRevisions          BudgetRevision[]             @relation("BudgetRevisionCreator")
  importedSinapiCatalogs   SinapiCatalog[]              @relation("SinapiImporter")
  assignedMaintenancePlans MaintenancePlan[]            @relation("MaintenancePlanAssignee")
  registeredPenalties      ContractPenalty[]            @relation("PenaltyRegistrar")
  auditLogs                AuditLog[]                   @relation("AuditActor")
  accountTokens            AccountToken[]
  invitationsSent          TenantInvitation[]           @relation("InvitationSender")
  geocodingConfirmations   Building[]                   @relation("BuildingGeocodingConfirmer")
  acceptedWorkOrders       WorkOrder[]                  @relation("WorkOrderAccepter")
  workOrderComments        WorkOrderComment[]
  commentMentions          WorkOrderCommentMention[]
  checklistResponses       WorkOrderChecklistResponse[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  notificationOutbox       NotificationOutbox[]
  workOrderReopenings      WorkOrderReopening[]

  @@index([status])
  @@index([deletedAt])
}

model TenantMembership {
  id              String            @id @default(uuid()) @db.Char(36)
  tenantId        String            @db.Char(36)
  userId          String            @db.Char(36)
  role            MembershipRole    @default(REQUESTER)
  status          MembershipStatus  @default(ACTIVE)
  invitedAt       DateTime?
  acceptedAt      DateTime?
  expiresAt       DateTime?
  sessionVersion  Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshSessions RefreshSession[]
  invitation      TenantInvitation?

  @@unique([tenantId, userId])
  @@index([tenantId, role, status])
  @@index([userId, status])
}

model RefreshSession {
  id           String           @id @default(uuid()) @db.Char(36)
  userId       String           @db.Char(36)
  membershipId String           @db.Char(36)
  tokenHash    String           @unique @db.Char(64)
  expiresAt    DateTime
  revokedAt    DateTime?
  userAgent    String?          @db.VarChar(500)
  ipAddress    String?          @db.VarChar(64)
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([membershipId, revokedAt])
}

model TenantInvitation {
  id              String           @id @default(uuid()) @db.Char(36)
  tenantId        String           @db.Char(36)
  membershipId    String           @unique @db.Char(36)
  invitedByUserId String           @db.Char(36)
  email           String           @db.VarChar(190)
  tokenHash       String           @unique @db.Char(64)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership      TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, email, acceptedAt, revokedAt])
  @@index([expiresAt])
}

model AccountToken {
  id         String              @id @default(uuid()) @db.Char(36)
  userId     String              @db.Char(36)
  purpose    AccountTokenPurpose
  tokenHash  String              @unique @db.Char(64)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt, expiresAt])
}

model TenantSequence {
  id           String   @id @default(uuid()) @db.Char(36)
  tenantId     String   @db.Char(36)
  key          String   @db.VarChar(80)
  currentValue Int      @default(0)
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model Building {
  id                         String             @id @default(uuid()) @db.Char(36)
  tenantId                   String             @db.Char(36)
  code                       String             @db.VarChar(40)
  name                       String             @db.VarChar(180)
  type                       String?            @db.VarChar(100)
  status                     BuildingStatus     @default(ACTIVE)
  managerUserId              String?            @db.Char(36)
  addressLine1               String             @db.VarChar(220)
  addressLine2               String?            @db.VarChar(160)
  district                   String?            @db.VarChar(120)
  city                       String             @db.VarChar(120)
  state                      String             @db.Char(2)
  postalCode                 String             @db.VarChar(12)
  country                    String             @default("BR") @db.Char(2)
  latitude                   Decimal?           @db.Decimal(10, 7)
  longitude                  Decimal?           @db.Decimal(10, 7)
  geocodedAt                 DateTime?
  geocodingProvider          String?            @db.VarChar(60)
  geocodingAccuracy          String?            @db.VarChar(60)
  geocodingPlaceId           String?            @db.VarChar(190)
  geocodingConfirmedAt       DateTime?
  geocodingConfirmedByUserId String?            @db.Char(36)
  grossAreaM2                Decimal?           @db.Decimal(14, 2)
  constructionYear           Int?
  floors                     Int?
  metadata                   Json?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  deletedAt                  DateTime?
  tenant                     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  manager                    User?              @relation("BuildingManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  geocodingConfirmedBy       User?              @relation("BuildingGeocodingConfirmer", fields: [geocodingConfirmedByUserId], references: [id], onDelete: SetNull)
  contracts                  ContractBuilding[]
  workOrders                 WorkOrder[]
  assets                     Asset[]
  maintenancePlans           MaintenancePlan[]
  kpiMeasurements            KpiMeasurement[]

  @@unique([tenantId, code])
  @@index([tenantId, status, deletedAt])
  @@index([tenantId, city, state])
  @@index([latitude, longitude])
}

model Supplier {
  id               String            @id @default(uuid()) @db.Char(36)
  tenantId         String            @db.Char(36)
  legalName        String            @db.VarChar(200)
  tradeName        String?           @db.VarChar(180)
  taxId            String            @db.VarChar(24)
  status           SupplierStatus    @default(ACTIVE)
  email            String?           @db.VarChar(190)
  phone            String?           @db.VarChar(30)
  contactName      String?           @db.VarChar(160)
  address          Json?
  serviceAreas     Json?
  notes            String?           @db.Text
  rating           Decimal?          @db.Decimal(3, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contracts        Contract[]
  directWorkOrders WorkOrder[]
  penalties        ContractPenalty[]
  kpiMeasurements  KpiMeasurement[]
  maintenancePlans MaintenancePlan[]

  @@unique([tenantId, taxId])
  @@index([tenantId, status, deletedAt])
  @@index([tenantId, legalName])
}

model Contract {
  id                    String                @id @default(uuid()) @db.Char(36)
  tenantId              String                @db.Char(36)
  supplierId            String                @db.Char(36)
  code                  String                @db.VarChar(80)
  administrativeProcess String?               @db.VarChar(120)
  object                String                @db.Text
  type                  ContractType
  status                ContractStatus        @default(DRAFT)
  managerUserId         String?               @db.Char(36)
  inspectorUserId       String?               @db.Char(36)
  startDate             DateTime
  endDate               DateTime
  signatureDate         DateTime?
  originalValue         Decimal               @db.Decimal(16, 2)
  currentValue          Decimal               @db.Decimal(16, 2)
  measuredValue         Decimal               @default(0) @db.Decimal(16, 2)
  paidValue             Decimal               @default(0) @db.Decimal(16, 2)
  adjustmentBaseDate    DateTime?
  adjustmentIndex       String?               @db.VarChar(80)
  notes                 String?               @db.Text
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplier              Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  manager               User?                 @relation("ContractManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  inspector             User?                 @relation("ContractInspector", fields: [inspectorUserId], references: [id], onDelete: SetNull)
  buildings             ContractBuilding[]
  workOrders            WorkOrderContract[]
  amendments            ContractAmendment[]
  adjustments           ContractAdjustment[]
  subcontractors        ContractSubcontract[]
  penalties             ContractPenalty[]
  commitments           Commitment[]
  measurements          Measurement[]
  maintenancePlans      MaintenancePlan[]
  kpiMeasurements       KpiMeasurement[]
  slaPolicies           SlaPolicy[]

  @@unique([tenantId, code])
  @@index([tenantId, status, endDate, deletedAt])
  @@index([tenantId, supplierId, status])
}

model ContractBuilding {
  id         String   @id @default(uuid()) @db.Char(36)
  contractId String   @db.Char(36)
  buildingId String   @db.Char(36)
  createdAt  DateTime @default(now())
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([contractId, buildingId])
  @@index([buildingId])
}

model ContractAmendment {
  id            String        @id @default(uuid()) @db.Char(36)
  contractId    String        @db.Char(36)
  number        String        @db.VarChar(60)
  type          AmendmentType
  description   String        @db.Text
  signedAt      DateTime?
  effectiveAt   DateTime?
  endDateBefore DateTime?
  endDateAfter  DateTime?
  valueChange   Decimal?      @db.Decimal(16, 2)
  createdAt     DateTime      @default(now())
  contract      Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, number])
}

model ContractAdjustment {
  id              String         @id @default(uuid()) @db.Char(36)
  contractId      String         @db.Char(36)
  type            AdjustmentType
  referencePeriod String         @db.VarChar(20)
  requestDate     DateTime?
  approvalDate    DateTime?
  percentage      Decimal?       @db.Decimal(9, 6)
  amount          Decimal?       @db.Decimal(16, 2)
  indexName       String?        @db.VarChar(100)
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  contract        Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, type, referencePeriod])
}

model ContractSubcontract {
  id                 String    @id @default(uuid()) @db.Char(36)
  contractId         String    @db.Char(36)
  subcontractorName  String    @db.VarChar(200)
  subcontractorTaxId String?   @db.VarChar(24)
  scope              String    @db.Text
  amount             Decimal?  @db.Decimal(16, 2)
  startDate          DateTime?
  endDate            DateTime?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  contract           Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model ContractPenalty {
  id                 String      @id @default(uuid()) @db.Char(36)
  tenantId           String      @db.Char(36)
  contractId         String?     @db.Char(36)
  supplierId         String      @db.Char(36)
  registeredByUserId String?     @db.Char(36)
  type               PenaltyType
  administrativeCase String?     @db.VarChar(120)
  description        String      @db.Text
  amount             Decimal?    @db.Decimal(16, 2)
  appliedAt          DateTime
  startsAt           DateTime?
  endsAt             DateTime?
  status             String      @default("ACTIVE") @db.VarChar(30)
  createdAt          DateTime    @default(now())
  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contract           Contract?   @relation(fields: [contractId], references: [id], onDelete: SetNull)
  supplier           Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  registeredBy       User?       @relation("PenaltyRegistrar", fields: [registeredByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, supplierId, appliedAt])
  @@index([contractId])
}

model Commitment {
  id              String               @id @default(uuid()) @db.Char(36)
  tenantId        String               @db.Char(36)
  contractId      String               @db.Char(36)
  createdByUserId String?              @db.Char(36)
  number          String               @db.VarChar(80)
  fiscalYear      Int
  issueDate       DateTime
  originalValue   Decimal              @db.Decimal(16, 2)
  notes           String?              @db.Text
  canceledAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contract        Contract             @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdBy       User?                @relation("CommitmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  movements       CommitmentMovement[]
  measurements    Measurement[]

  @@unique([tenantId, number, fiscalYear])
  @@index([tenantId, contractId, fiscalYear])
}

model CommitmentMovement {
  id              String                 @id @default(uuid()) @db.Char(36)
  tenantId        String                 @db.Char(36)
  commitmentId    String                 @db.Char(36)
  measurementId   String?                @db.Char(36)
  createdByUserId String?                @db.Char(36)
  type            CommitmentMovementType
  amount          Decimal                @db.Decimal(16, 2)
  occurredAt      DateTime
  documentRef     String?                @db.VarChar(120)
  notes           String?                @db.Text
  createdAt       DateTime               @default(now())
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  commitment      Commitment             @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  measurement     Measurement?           @relation(fields: [measurementId], references: [id], onDelete: SetNull)
  createdBy       User?                  @relation("CommitmentMovementCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([commitmentId, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([measurementId, type])
}

model WorkOrder {
  id                          String                     @id @default(uuid()) @db.Char(36)
  tenantId                    String                     @db.Char(36)
  number                      String                     @db.VarChar(40)
  buildingId                  String                     @db.Char(36)
  requesterUserId             String                     @db.Char(36)
  assignedToUserId            String?                    @db.Char(36)
  createdByUserId             String                     @db.Char(36)
  supplierId                  String?                    @db.Char(36)
  categoryId                  String?                    @db.Char(36)
  specialtyId                 String?                    @db.Char(36)
  environmentId               String?                    @db.Char(36)
  causeId                     String?                    @db.Char(36)
  slaPolicyId                 String?                    @db.Char(36)
  acceptedByUserId            String?                    @db.Char(36)
  title                       String                     @db.VarChar(220)
  description                 String                     @db.Text
  locationDetail              String?                    @db.VarChar(220)
  origin                      WorkOrderOrigin            @default(USER_REQUEST)
  priority                    WorkOrderPriority          @default(NORMAL)
  status                      WorkOrderStatus            @default(OPEN)
  hasOpenPendency             Boolean                    @default(false)
  openedAt                    DateTime                   @default(now())
  triagedAt                   DateTime?
  assignedAt                  DateTime?
  startedAt                   DateTime?
  completedAt                 DateTime?
  closedAt                    DateTime?
  acceptedAt                  DateTime?
  reopenedAt                  DateTime?
  canceledAt                  DateTime?
  dueAt                       DateTime?
  slaResponseDeadline         DateTime?
  slaResolutionDeadline       DateTime?
  slaResolutionWarningAt      DateTime?
  estimatedCost               Decimal?                   @db.Decimal(16, 2)
  approvedCost                Decimal?                   @db.Decimal(16, 2)
