  eventType       NotificationEventType
  payload         Json
  status          NotificationOutboxStatus @default(PENDING)
  attempts        Int                      @default(0)
  availableAt     DateTime                 @default(now())
  processedAt     DateTime?
  lastError       String?                  @db.Text
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient       User                     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([tenantId, recipientUserId, createdAt])
}

model WorkOrderReopening {
  id                             String          @id @default(uuid()) @db.Char(36)
  tenantId                       String          @db.Char(36)
  workOrderId                    String          @db.Char(36)
  reopenedByUserId               String          @db.Char(36)
  previousStatus                 WorkOrderStatus
  reason                         String          @db.Text
  previousClosedAt               DateTime?
  previousSolution               String?         @db.Text
  previousFinalCost              Decimal?        @db.Decimal(16, 2)
  previousAcceptanceNote         String?         @db.Text
  previousAcceptedAt             DateTime?
  previousAcceptedByUserId       String?         @db.Char(36)
  previousMeasurementEligible    Boolean         @default(false)
  previousSlaPolicyId            String?         @db.Char(36)
  previousSlaResponseDeadline    DateTime?
  previousSlaResolutionDeadline  DateTime?
  previousSlaResolutionWarningAt DateTime?
  previousSlaSnapshot            Json?
  previousSatisfactionSnapshot   Json?
  within30Days                   Boolean
  reopenedAt                     DateTime        @default(now())
  tenant                         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workOrder                      WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  reopenedBy                     User            @relation(fields: [reopenedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, within30Days, reopenedAt])
  @@index([workOrderId, reopenedAt])
}

model Asset {
  id               String            @id @default(uuid()) @db.Char(36)
  tenantId         String            @db.Char(36)
  buildingId       String            @db.Char(36)
  tag              String            @db.VarChar(80)
  name             String            @db.VarChar(180)
  category         String            @db.VarChar(120)
  location         String?           @db.VarChar(180)
  manufacturer     String?           @db.VarChar(120)
  model            String?           @db.VarChar(120)
  serialNumber     String?           @db.VarChar(120)
  criticality      AssetCriticality  @default(MEDIUM)
  status           AssetStatus       @default(ACTIVE)
  installedAt      DateTime?
  warrantyEndsAt   DateTime?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  building         Building          @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  maintenancePlans MaintenancePlan[]

  @@unique([tenantId, tag])
  @@index([tenantId, buildingId, status, deletedAt])
}

model MaintenancePlan {
  id                    String                      @id @default(uuid()) @db.Char(36)
  tenantId              String                      @db.Char(36)
  buildingId            String                      @db.Char(36)
  assetId               String?                     @db.Char(36)
  contractId            String?                     @db.Char(36)
  categoryId            String?                     @db.Char(36)
  specialtyId           String?                     @db.Char(36)
  supplierId            String?                     @db.Char(36)
  assignedToUserId      String?                     @db.Char(36)
  name                  String                      @db.VarChar(180)
  titleTemplate         String                      @db.VarChar(220)
  description           String?                     @db.Text
  type                  MaintenancePlanType
  frequencyUnit         FrequencyUnit
  frequencyValue        Int                         @default(1)
  nextDueAt             DateTime
  lastGeneratedAt       DateTime?
  defaultPriority       WorkOrderPriority           @default(NORMAL)
  advanceDays           Int                         @default(0)
  generationHorizonDays Int                         @default(30)
  checklistTemplate     Json?
  active                Boolean                     @default(true)
  suspendedAt           DateTime?
  lastErrorAt           DateTime?
  lastError             String?                     @db.Text
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  building              Building                    @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  asset                 Asset?                      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  contract              Contract?                   @relation(fields: [contractId], references: [id], onDelete: SetNull)
  category              OperationalCatalogItem?     @relation("MaintenancePlanCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  specialty             OperationalCatalogItem?     @relation("MaintenancePlanSpecialty", fields: [specialtyId], references: [id], onDelete: SetNull)
  supplier              Supplier?                   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  assignedTo            User?                       @relation("MaintenancePlanAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  generatedWorkOrders   WorkOrder[]
  generations           MaintenancePlanGeneration[]

  @@index([tenantId, active, nextDueAt])
  @@index([buildingId, type])
}

model MaintenancePlanGeneration {
  id           String                      @id @default(uuid()) @db.Char(36)
  tenantId     String                      @db.Char(36)
  planId       String                      @db.Char(36)
  workOrderId  String?                     @unique @db.Char(36)
  scheduledFor DateTime
  status       MaintenanceGenerationStatus @default(PENDING)
  generatedAt  DateTime?
  skippedAt    DateTime?
  skipReason   String?                     @db.Text
  error        String?                     @db.Text
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan         MaintenancePlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder?                  @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@unique([planId, scheduledFor])
  @@index([tenantId, status, scheduledFor])
}

model KpiDefinition {
  id            String           @id @default(uuid()) @db.Char(36)
  tenantId      String           @db.Char(36)
  code          String           @db.VarChar(80)
  name          String           @db.VarChar(180)
  description   String?          @db.Text
  category      KpiCategory
  unit          String           @db.VarChar(40)
  direction     KpiDirection
  periodicity   KpiPeriodicity   @default(MONTHLY)
  version       Int              @default(1)
  source        String?          @db.VarChar(80)
  decimalPlaces Int              @default(2)
  formula       String?          @db.Text
  targetValue   Decimal?         @db.Decimal(18, 6)
  warningValue  Decimal?         @db.Decimal(18, 6)
  criticalValue Decimal?         @db.Decimal(18, 6)
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  measurements  KpiMeasurement[]

  @@unique([tenantId, code])
  @@index([tenantId, category, active])
}

model KpiMeasurement {
  id             String               @id @default(uuid()) @db.Char(36)
  tenantId       String               @db.Char(36)
  definitionId   String               @db.Char(36)
  buildingId     String?              @db.Char(36)
  contractId     String?              @db.Char(36)
  supplierId     String?              @db.Char(36)
  periodStart    DateTime
  periodEnd      DateTime
  value          Decimal              @db.Decimal(18, 6)
  status         KpiMeasurementStatus @default(FINAL)
  calculationKey String               @unique @db.Char(64)
  formulaVersion Int                  @default(1)
  targetValue    Decimal?             @db.Decimal(18, 6)
  source         String?              @db.VarChar(80)
  details        Json?
  computedAt     DateTime             @default(now())
  createdAt      DateTime             @default(now())
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definition     KpiDefinition        @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  building       Building?            @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  contract       Contract?            @relation(fields: [contractId], references: [id], onDelete: SetNull)
  supplier       Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([tenantId, definitionId, periodEnd])
  @@index([tenantId, buildingId, periodEnd])
  @@index([tenantId, contractId, periodEnd])
}

model SaaSPlan {
  id                  String               @id @default(uuid()) @db.Char(36)
  code                String               @unique @db.VarChar(50)
  name                String               @db.VarChar(100)
  billingInterval     BillingInterval
  priceBrl            Decimal              @db.Decimal(12, 2)
  stripePriceId       String?              @unique @db.VarChar(120)
  maxBuildings        Int?
  maxOperationalUsers Int?
  maxStorageGb        Int?
  maxWorkOrdersYear   Int?
  features            Json?
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  subscriptions       TenantSubscription[]
}

model TenantSubscription {
  id                   String             @id @default(uuid()) @db.Char(36)
  tenantId             String             @db.Char(36)
  planId               String             @db.Char(36)
  status               SubscriptionStatus
  stripeSubscriptionId String?            @unique @db.VarChar(120)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan                 SaaSPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
}

model StripeWebhookEvent {
  id          String    @id @default(uuid()) @db.Char(36)
  stripeId    String    @unique @db.VarChar(120)
  type        String    @db.VarChar(120)
  apiVersion  String?   @db.VarChar(30)
  payload     Json
  processedAt DateTime?
  error       String?   @db.Text
  createdAt   DateTime  @default(now())

  @@index([type, processedAt])
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Char(36)
  tenantId    String      @db.Char(36)
  actorUserId String?     @db.Char(36)
  action      AuditAction
  entityType  String      @db.VarChar(100)
  entityId    String?     @db.VarChar(64)
  beforeData  Json?
  afterData   Json?
  ipAddress   String?     @db.VarChar(64)
  userAgent   String?     @db.VarChar(500)
  occurredAt  DateTime    @default(now())
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor       User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId, occurredAt])
  @@index([tenantId, actorUserId, occurredAt])
}
