  @@index([tenantId, categoryId, status, openedAt])
  @@index([tenantId, specialtyId, status, openedAt])
  @@index([tenantId, environmentId, status, openedAt])
  @@index([tenantId, causeId, status, openedAt])
  @@index([tenantId, maintenancePlanId, preventiveScheduledFor])
