# Documentation only. Never replace an existing environment with this template.
# Fill privately after separate authorization; do not commit the completed file.
# GESTAO_ENV_FILE is supplied to the launcher, pointing to that private file.
NODE_ENV=production
GESTAO_ENABLED=true
GESTAO_STANDALONE=true
ORCAPRO_ENABLED=false
INFRA_ENABLED=false
WEB_BASE_URL=https://www.orcaprogestaocontratual.com.br
CORS_ORIGINS=https://orcaprogestaocontratual.com.br,https://www.orcaprogestaocontratual.com.br
COOKIE_SECURE=true
MAX_JSON_MB=20
DB_CONNECTION_LIMIT=3
DATABASE_URL=
GESTAO_DATABASE_URL=
GESTAO_SOURCE_ORCAPRO_AUTH_URL=
GESTAO_SOURCE_INFRA_AUTH_URL=
GESTAO_SOURCE_INFRA_DATA_URL=
GESTAO_SOURCE_ORCAPRO_ADMIN_IDS=
GESTAO_SOURCE_INFRA_ADMIN_IDS=
# Both email AND user ID are required for SaaS root recognition.
GESTAO_ADMIN_EMAIL=
GESTAO_ADMIN_USER_IDS=
JWT_ACCESS_SECRET=
GESTAO_STORAGE_ROOT=
GESTAO_STORAGE_LIMIT_BYTES=104857600
GESTAO_STRIPE_MODE=live
GESTAO_STRIPE_SECRET_KEY=
GESTAO_STRIPE_WEBHOOK_SECRET=
GESTAO_STRIPE_PRICE_ID=
GESTAO_STRIPE_PORTAL_CONFIGURATION_ID=
EMAIL_PROVIDER=smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD_FILE=
